---
// Precision vs prevalence (log x). precision(pi) = TPR*pi / (TPR*pi + FPR*(1 - pi)).
// One highlighted judge in the "favourable condition" colour, the others as thin grey context.
interface Judge { label: string; tpr: number; fpr: number }
interface Props { title: string; highlight: Judge; others: Judge[] }
const { title, highlight, others } = Astro.props;

const W = 680, H = 320, L = 48, R = 84, T = 14, B = 44;
const lo = Math.log10(0.001), hi = Math.log10(0.5);
const x = (pi: number) => L + ((Math.log10(pi) - lo) / (hi - lo)) * (W - L - R);
const y = (p: number) => T + (1 - p) * (H - T - B);
const prec = (j: Judge, pi: number) => (j.tpr * pi) / (j.tpr * pi + j.fpr * (1 - pi));
const path = (j: Judge) => {
  const pts = [];
  for (let k = 0; k <= 120; k++) {
    const pi = 10 ** (lo + ((hi - lo) * k) / 120);
    pts.push(`${k ? 'L' : 'M'}${x(pi).toFixed(1)},${y(prec(j, pi)).toFixed(1)}`);
  }
  return pts.join('');
};
const xt = [[0.001, '0.1%'], [0.01, '1%'], [0.1, '10%'], [0.5, '50%']] as const;
const marks = [0.5, 0.1, 0.01].map((pi) => ({ pi, p: prec(highlight, pi) }));
const fmt = (p: number) => p.toFixed(2);
const pct = (pi: number) => `${+(pi * 100).toFixed(1)}%`;
---
<svg class="chart curve" viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="prev-t">
  <title id="prev-t">{title}</title>
  {[0, 0.25, 0.5, 0.75, 1].map((t) => (
    <g>
      <line class="grid" x1={L} x2={W - R} y1={y(t)} y2={y(t)} />
      <text class="tick" x={L - 8} y={y(t) + 4} text-anchor="end">{t === 0 ? '0' : t.toFixed(2).replace(/0$/, '')}</text>
    </g>
  ))}
  {xt.map(([pi, l]) => (
    <g>
      <line class="grid" x1={x(pi)} x2={x(pi)} y1={T} y2={H - B} />
      <text class="tick" x={x(pi)} y={H - B + 18} text-anchor="middle">{l}</text>
    </g>
  ))}
  <text class="axis-label" x={(L + W - R) / 2} y={H - 4} text-anchor="middle">Share of responses with a hidden intention (log scale)</text>
  <text class="axis-label" transform={`translate(13 ${(T + H - B) / 2}) rotate(-90)`} text-anchor="middle">Precision</text>

  {others.map((j) => (
    <path class="context" d={path(j)}><title>{`${j.label}: precision ${fmt(prec(j, 0.5))} at 50%, ${fmt(prec(j, 0.01))} at 1%`}</title></path>
  ))}
  <path class="focus" d={path(highlight)} />
  {marks.map((m) => (
    <g class="mark">
      <title>{`${highlight.label}: precision ${fmt(m.p)} at ${pct(m.pi)} prevalence`}</title>
      <circle class="hit" cx={x(m.pi)} cy={y(m.p)} r="12" />
      <circle class="dot-a" cx={x(m.pi)} cy={y(m.p)} r="5" />
      <text class="direct" x={x(m.pi) + (m.pi === 0.5 ? 10 : -10)} y={y(m.p) - 10} text-anchor={m.pi === 0.5 ? 'start' : 'end'}>{fmt(m.p)}</text>
    </g>
  ))}
  <text class="end-label" x={x(0.5) + 10} y={y(prec(highlight, 0.5)) + 16}>{highlight.label}</text>
  <text class="end-label muted" x={x(0.5) + 10} y={y(prec(others[0], 0.5)) + 4}>other judges</text>
</svg>
